<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Fingerprint unlock for the app lock (framework BiometricManager/BiometricPrompt). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Only for scanning a server-settings QR code; asked for when you tap Scan. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Notifications (asked for when you turn them on in Settings → Notifications). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the Notifications screen ask Android to stop delaying ArrCtrl's checks. Nothing is changed without your OK. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- WorkManager adds the foreground-service permission for long jobs shown as a notification. ArrCtrl's checks and
         widget refreshes are short jobs that never run as a foreground service, so it's removed (with the service below). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />

    <!-- Package visibility for the "Play in JellyCtrl" and "Open in SeerrCtrl" buttons, and for ntfy,
         the only push app ArrCtrl uses. -->
    <queries>
        <package android:name="com.vknxworks.jellyctrl" />
        <package android:name="com.vknxworks.seerrctrl" />
        <package android:name="io.heckel.ntfy" />
        <intent>
            <action android:name="org.unifiedpush.android.distributor.REGISTER" />
        </intent>
    </queries>

    <application
        android:name=".ArrCtrlApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.ArrCtrl">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|density|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-pressing the Quick Settings tile opens the Torrents tab. -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
            <!-- magnet: links from browsers and other apps (ArrCtrl can be set as the default). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="magnet" />
            </intent-filter>
            <!-- Opening a .torrent file (content:// from another app only; file:// paths are refused). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:mimeType="application/x-bittorrent" />
            </intent-filter>
            <!-- arrctrl://movie?tmdb=… and arrctrl://series?tvdb=…&tmdb=… from other apps (JellyCtrl, SeerrCtrl).
                 Not BROWSABLE, so web pages can't open them; MainActivity checks every link and it only opens a
                 screen once the app lock is unlocked. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="arrctrl" android:host="movie" />
                <data android:scheme="arrctrl" android:host="series" />
            </intent-filter>
            <!-- Share sheet: a .torrent file, or text containing a magnet link. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/x-bittorrent" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Wake-ups from ntfy. Exported because ntfy is another app; every broadcast must carry the secret
             token of ArrCtrl's registration or it's ignored. -->
        <receiver
            android:name=".data.notify.PushReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.MESSAGE" />
                <action android:name="org.unifiedpush.android.connector.UNREGISTERED" />
                <action android:name="org.unifiedpush.android.connector.NEW_ENDPOINT" />
                <action android:name="org.unifiedpush.android.connector.REGISTRATION_FAILED" />
                <action android:name="org.unifiedpush.android.connector.TEMP_UNAVAILABLE" />
            </intent-filter>
        </receiver>
        <!-- ntfy binds to this for a few seconds before a wake-up, so ArrCtrl can check your servers at once. -->
        <service
            android:name=".data.notify.RaiseToForegroundService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.RAISE_TO_FOREGROUND" />
            </intent-filter>
        </service>

        <!-- Home screen widgets (Glance). Not exported: only the system's widget host sends them updates. -->
        <receiver
            android:name=".widget.UpcomingWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_upcoming">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/upcoming_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.DownloadsWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_downloads">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/downloads_widget_info" />
        </receiver>

        <!-- Quick Settings tile: qBittorrent's alternative speed limits. -->
        <service
            android:name=".tile.AltSpeedTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_speed"
            android:label="@string/tile_alt_speed"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- WorkManager's diagnostics receiver isn't used; drop it so ArrCtrl exposes nothing it doesn't need. -->
        <receiver
            android:name="androidx.work.impl.diagnostics.DiagnosticsReceiver"
            tools:node="remove" />

        <!-- AndroidX's profile installer receiver lets other apps ask ArrCtrl to write or skip its ART
             profile. It isn't needed; drop it. -->
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:node="remove" />

        <!-- WorkManager's foreground service, for long jobs shown as a notification. ArrCtrl never uses it. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            tools:node="remove" />

        <!-- Don't let androidx.emoji2 look up a downloadable emoji font at start-up: emoji are drawn with the
             phone's own emoji font, and nothing is fetched. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
